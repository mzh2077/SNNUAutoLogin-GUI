<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SNNUAutoLogin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SNNUAutoLogin</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- 文件属性（exe 右键「属性 → 详细信息」与「应用和功能」列表里显示的内容） -->
    <Version>1.6.0</Version>
    <FileVersion>1.6.0.0</FileVersion>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <Product>陕师大校园网自动登录</Product>
    <AssemblyTitle>陕师大校园网自动登录</AssemblyTitle>
    <Company>SNNU</Company>
    <Description>陕西师范大学校园网自动认证工具</Description>
    <Copyright>Copyright © 2026 SNNU</Copyright>
    <!-- 只保留简体中文资源，去掉其余 20 多种语言的 .resources.dll -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!--
      这个程序常驻托盘，堆只有几 MB：
      - 关闭并发 GC：少一条后台 GC 线程和一小块记账内存，暂停时间对这么小的堆可以忽略；
      - 明确工作站 GC：别让 SDK 在某些配置下按服务端 GC 展开更多的堆。
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>

    <!-- 用自建 Program.Main 取代 XAML 生成入口：提权写 hosts 的子进程不必初始化 WinUI，
         启动时间从 ~800ms 降到几十毫秒，也不会闪出窗口 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- 发布版不带调试符号；分层 PGO 让热路径（巡检循环、日志派发）跑几条后自动优化 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    发布后剔除本项目用不到的运行时组件：Windows ML（onnxruntime + DirectML 共约 39MB）、
      桌面小组件、.NET 崩溃转储支持、以及 80 多个语言的 .mui 本地化资源
      （界面文案全是写死的中文，控件默认文案走 neutral 回退）。
      剔除后仍可正常启动（已用 snapshot / ui-test 两个自检模式回归验证）。

      下面这批程序集是按「运行期真实加载的模块清单」逐个比对出来的：
      跑一遍全功能自检后用 tasklist /m 导出已加载 DLL，未出现在清单里且不属于
      惰性加载路径的才删。删错会表现为启动即崩（XamlParseException）或某个功能点了没反应，
      所以每次调整都要重跑 snapshot / ui-test / login-selftest 三个自检。
    -->
  <Target Name="TrimUnusedRuntime" AfterTargets="Publish">
    <PropertyGroup>
      <TrimRoot Condition="'$(PublishDir)' != ''">$(PublishDir)</TrimRoot>
      <TrimRoot Condition="'$(TrimRoot)' == ''">$(OutDir)</TrimRoot>

      <!-- 目标执行时才枚举目录：评估阶段 publish 输出还不存在 -->
      <TrimDirs>$([System.IO.Directory]::GetDirectories('$(TrimRoot)'))</TrimDirs>
    </PropertyGroup>

    <ItemGroup>
      <UnusedRuntime Include="$(TrimRoot)onnxruntime.dll" />
      <UnusedRuntime Include="$(TrimRoot)onnxruntime_providers_shared.dll" />
      <UnusedRuntime Include="$(TrimRoot)DirectML.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.ML.OnnxRuntime.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.Windows.AI.MachineLearning.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.Windows.Widgets.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.Windows.Widgets.Projection.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.Windows.Widgets.winmd" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.DiaSymReader.Native.amd64.dll" />
      <UnusedRuntime Include="$(TrimRoot)mscordaccore.dll" />
      <UnusedRuntime Include="$(TrimRoot)mscordaccore_amd64_amd64_*.dll" />
      <UnusedRuntime Include="$(TrimRoot)mscordbi.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.Web.WebView2.Core.dll" />
      <UnusedRuntime Include="$(TrimRoot)Microsoft.Web.WebView2.Core.Projection.dll" />
      <UnusedRuntime Include="$(TrimRoot)WebView2Loader.dll" />

      <!-- 语言资源目录：只留简中与英文回退 -->
      <UnusedLocaleDir Include="$(TrimDirs)" />
      <UnusedLocaleDir Remove="$(TrimRoot)zh-CN;$(TrimRoot)en-us" />
      <UnusedLocaleDir Remove="$(TrimRoot)Microsoft.UI.Xaml;$(TrimRoot)NpuDetect" />
    </ItemGroup>

    <!--
      运行期从不加载的程序集。判断依据：全功能自检后 tasklist /m 的模块清单里没有它们，
      且依赖闭包里也没有惰性加载它们的路径。
    -->
    <ItemGroup>
      <!-- 7.6MB：XAML 编译成 .xbf，运行期不解析 XML；本项目也不用 XmlDocument -->
      <UnusedAssembly Include="$(TrimRoot)System.Private.Xml.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Private.Xml.Linq.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Xml.ReaderWriter.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Xml.XDocument.dll" />
      <!-- 没有 ADO.NET / WCF / VB / dynamic 用法 -->
      <UnusedAssembly Include="$(TrimRoot)System.Data.Common.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Private.DataContractSerialization.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Transactions.Local.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.VisualBasic.Core.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.CSharp.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Reflection.Metadata.dll" />
      <!-- 用不到的网络/并发/序列化分支 -->
      <UnusedAssembly Include="$(TrimRoot)System.Net.HttpListener.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Net.Mail.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Net.Requests.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Linq.Parallel.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Collections.Immutable.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Threading.Tasks.Dataflow.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.Numerics.Tensors.dll" />
      <UnusedAssembly Include="$(TrimRoot)System.ComponentModel.TypeConverter.dll" />
      <!-- WinUI 的 Phone 控件集与 AI/ML 投影，本项目完全不碰 -->
      <UnusedAssembly Include="$(TrimRoot)Microsoft.UI.Xaml.Phone.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.Windows.AI.*.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.Windows.Vision*.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.Windows.SemanticSearch*.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.Windows.Workloads*.dll" />
      <UnusedAssembly Include="$(TrimRoot)Microsoft.Windows.Private.Workloads*.dll" />

      <!-- .NET 崩溃转储工具、WinAppSDK 重启代理、调试符号、Windows ML 工作负载清单 -->
      <UnusedFile Include="$(TrimRoot)createdump.exe" />
      <UnusedFile Include="$(TrimRoot)RestartAgent.exe" />
      <UnusedFile Include="$(TrimRoot)SNNUAutoLogin.pdb" />
      <UnusedFile Include="$(TrimRoot)workloads*.json" />
      <UnusedFile Include="$(TrimRoot)*.winmd" />
    </ItemGroup>

    <Message Importance="high" Text="TrimUnusedRuntime: $(TrimRoot) 剔除 @(UnusedRuntime->Count()) 个未使用组件、@(UnusedAssembly->Count()) 个未加载程序集、@(UnusedFile->Count()) 个资源文件、@(UnusedLocaleDir->Count()) 个语言目录" />
    <Delete Files="@(UnusedRuntime);@(UnusedAssembly);@(UnusedFile)" ContinueOnError="true" />
    <RemoveDir Directories="@(UnusedLocaleDir)" ContinueOnError="true" />

    <!-- NPU 探测只在 Windows ML 场景用；顺带删掉。刻意不动 WinUIEdit.dll：
         它是 TextBox / RichEditBox 的编辑内核，删掉后 XAML 里第一个 TextBox 就创建不出来 -->
    <RemoveDir Directories="$(TrimRoot)NpuDetect" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs;Shared\**\*.cs;Linux\**\*.cs;Services\PortalClient.cs;Services\PortalPortDiscovery.cs;Services\ConnectionProfileResolver.cs;Services\ConnectionRules.cs;Services\DeviceListParser.cs;Services\IOnlineDevicePortal.cs;Services\DeviceManager.cs;Services\DeviceGuardService.cs;Services\NetworkProbeService.cs;Services\LoginCoordinator.cs;Services\OperationLifetime.cs" />
    <ProjectReference Include="Shared/SNNUAutoLogin.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
