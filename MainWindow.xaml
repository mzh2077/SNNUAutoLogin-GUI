<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SNNUAutoLogin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SNNUAutoLogin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        配色完全走系统：背景是 Mica（系统壁纸采样），控件前景/描边/填充一律用
        ThemeResource 里的 Fluent 语义刷子，强调色用系统口音色（AccentFillColor*），
        状态色用 SystemFillColor*。不自己从壁纸算颜色。

        版式遵循 WinUI 的几条硬规矩：
          · 页面左右留白统一 24，标题栏左侧起点也是 24，三者的左边缘落在同一条线上；
          · 卡片内边距统一 16，行高统一 44，分隔线顶格不留缝；
          · 「标签在左、控件在右」的行，控件列固定 220 且右对齐，所有行的右边缘齐平；
          · 设置内容最宽 780 居中，窗口再宽也不会把一行拉成两里地。

        分区：首页只留日常要看的（连接状态 / 在线设备 / 运行日志），
        其余配置全在设置页，关于单独一页。
    -->
    <Grid x:Name="Root" IsTabStop="True">
        <Grid.Resources>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlHighlightAccentBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush" />

            <!--  bool → Visibility：设备行里「点击下线」与「断开连接」按会话类型二选一  -->
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!--  ══ 尺寸：三条线，改这里就够  ══  -->
            <x:Double x:Key="PagePadding">24</x:Double>
            <x:Double x:Key="CardPadding">16</x:Double>
            <x:Double x:Key="RowHeight">44</x:Double>
            <x:Double x:Key="ControlWidth">220</x:Double>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  设置项：主标题  -->
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="HintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  设置项之间的分隔线：顶格，不留额外缝，行高自己撑开呼吸感  -->
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!--
                系统开关：不显示「开 / 关」文字，只留开关本体。
                模板内部为文字预留了 154 的 MinWidth（页面级覆盖该资源无效），
                因此用 Width 精确夹到轨道宽度 —— Width 会盖掉 MinWidth。
                ⚠ 必须用 Width 而不是 MaxWidth：轨道实测 44 宽，MaxWidth=40 会把轨道右侧裁掉一截。
            -->
            <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="OnContent" Value="{x:Null}" />
                <Setter Property="OffContent" Value="{x:Null}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="InlineLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Foreground" Value="{ThemeResource InlineLinkBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  表单控件底子：描边走系统语义色，高度对齐 32  -->
            <Style x:Key="FormInputStyle" TargetType="Control">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  行内输入框：固定 220 宽，所有行的右边缘才会齐  -->
            <Style x:Key="RowInputBase" TargetType="Control" BasedOn="{StaticResource FormInputStyle}">
                <Setter Property="Width" Value="220" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style
                x:Key="RowTextBoxStyle"
                BasedOn="{StaticResource RowInputBase}"
                TargetType="TextBox">
                <Setter Property="Height" Value="32" />
            </Style>

            <Style
                x:Key="RowPasswordBoxStyle"
                BasedOn="{StaticResource RowInputBase}"
                TargetType="PasswordBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="PasswordRevealMode" Value="Peek" />
            </Style>

            <Style
                x:Key="RowNumberBoxStyle"
                BasedOn="{StaticResource RowInputBase}"
                TargetType="NumberBox">
                <Setter Property="Width" Value="120" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            </Style>

            <!--  标题栏按钮：高度与系统的 caption 按钮一致（Tall = 48），宽度由代码按 DPI 覆写  -->
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  页头与卡片里的「只有一个图标」的按钮：平时透明，悬停才浮出底色  -->
            <Style x:Key="NavIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <!--  48 = WinUI 的 TitleBarHeightOption.Tall：系统的三枚 caption 按钮也是 48 高，
                  齿轮做成 48 就与它们同高同中线，不需要任何垂直偏移补偿。
                  代码会在运行时把这里改成系统实际给的高度（Win10 只有 32）  -->
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══════════ 标题栏  ══════════  -->
        <!--  右边距由代码按系统真实的 RightInset 覆盖，146 只是首帧兜底。
              左内边距 24 与页面留白取同一个数，图标左沿正好压在卡片左沿上。  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Margin="0,0,146,0"
            Padding="24,0,0,0"
            Background="Transparent"
            SizeChanged="OnTitleBarSized">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    x:Name="TitleIcon"
                    FontSize="16"
                    Glyph="&#xE701;" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="SNNU 校园网助手" />

                <StackPanel
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Ellipse
                        x:Name="TitleDot"
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="TitleState"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="检测中" />
                </StackPanel>
            </StackPanel>

            <!--  设置入口：与系统 caption 按钮同宽同高，紧挨最小化左侧  -->
            <Button
                x:Name="SettingsNavBtn"
                Grid.Column="1"
                Style="{StaticResource TitleBarButtonStyle}"
                IsTabStop="False"
                Click="OnSettingsNavClicked"
                ToolTipService.ToolTip="设置">
                <FontIcon FontSize="11" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  ══════════ 首页  ══════════  -->
        <Grid
            x:Name="HomePage"
            Grid.Row="1"
            Margin="24,0,24,20"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  1.4.0 起移除了网络加速：只在检测到旧版残留时出现，一键还原  -->
            <Border
                x:Name="LegacyHostsBar"
                Padding="14,9,8,9"
                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Glyph="&#xE946;" />

                    <TextBlock
                        x:Name="LegacyHostsText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />

                    <Button
                        x:Name="LegacyCleanBtn"
                        Grid.Column="2"
                        Height="28"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Content="还原解析"
                        FontSize="12"
                        Style="{StaticResource AccentButtonStyle}" />

                    <Button
                        x:Name="LegacyDismissBtn"
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="本次不再提示">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>

            <!--  ────────── 连接状态：整条横幅，左环 / 中文案 / 右操作 ──────────  -->
            <Border
                x:Name="StatusCard"
                Grid.Row="1"
                Style="{StaticResource CardStyle}">
                <Grid Padding="20,16,20,16" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="RingHost"
                        Width="72"
                        Height="72"
                        VerticalAlignment="Center">
                        <Ellipse x:Name="HaloRing" Width="72" Height="72" />

                        <ProgressRing
                            x:Name="BusyRing"
                            Width="72"
                            Height="72"
                            Visibility="Collapsed" />

                        <FontIcon
                            x:Name="StateIcon"
                            FontSize="30"
                            Glyph="&#xE73E;" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                x:Name="StateTitle"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="正在初始化" />

                            <Border
                                x:Name="AutoPill"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        x:Name="AutoDot"
                                        Width="6"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock
                                        x:Name="AutoLabel"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="自动登录 · 已启用" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock
                            x:Name="StateSubtitle"
                            MaxWidth="520"
                            FontSize="12.5"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正在读取本机状态…"
                            TextWrapping="Wrap" />

                        <!--  明细：三项横排，与标题左边缘对齐  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="账号" />
                                <TextBlock
                                    x:Name="AccText"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="—" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="本机 IP" />
                                <TextBlock
                                    x:Name="IpText"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="—" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="出口 IP" />
                                <TextBlock
                                    x:Name="PublicIpText"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="—" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Width="156"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="ConnectBtn"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="ConnectIcon" FontSize="13" Glyph="&#xE7E8;" />
                                    <TextBlock
                                        x:Name="ConnectLabel"
                                        FontSize="13"
                                        Text="立即登录" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RefreshBtn"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="刷新状态">
                                <Grid>
                                    <FontIcon x:Name="StatusRefreshIcon" FontSize="14" Glyph="&#xE72C;" />
                                    <ProgressRing
                                        x:Name="StatusRefreshProgress"
                                        Width="16"
                                        Height="16"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>

                        <!--  切换出口：会先断开再按新出口认证，属于「有影响但不破坏数据」，用次要按钮  -->
                        <Button
                            x:Name="SwitchOutletBtn"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            Content="切换出口"
                            Click="OnSwitchOutletClicked" />

                        <HyperlinkButton
                            x:Name="UpdateLink"
                            HorizontalAlignment="Left"
                            Style="{StaticResource InlineLinkStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="StatusRefreshMessage"
                            Style="{StaticResource HintStyle}"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ────────── 在线设备 + 运行日志  ──────────  -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DeviceCard" Style="{StaticResource CardStyle}">
                    <Grid Padding="16,12,16,12" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  卡头：标题 + 端口 + 刷新  -->
                        <Grid>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE968;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="在线设备" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    x:Name="DevicePortText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HintStyle}"
                                    Text="—" />
                                <Button
                                    x:Name="DeviceRefreshBtn"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    ToolTipService.ToolTip="刷新设备列表">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            x:Name="DeviceSummary"
                            Grid.Row="1"
                            Margin="0,6,0,10"
                            Style="{StaticResource HintStyle}"
                            Text="尚未加载" />

                        <ScrollViewer
                            Grid.Row="2"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="0,10"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  第一行：设备名 + IP + 状态  -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Status}" />
                                            </Grid>

                                            <!--  第二行：明细 + 操作  -->
                                            <Grid
                                                Grid.Row="1"
                                                Margin="0,4,0,0"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Ip}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding Detail}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6">

                                                    <!--  别的会话：强制下线（门户里的「强制下线」）  -->
                                                    <Button
                                                        Click="OnDeviceOfflineClicked"
                                                        Content="点击下线"
                                                        FontSize="12"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding CanForceOffline, Converter={StaticResource BoolToVisibility}}" />

                                                    <!--  本机当前这条连接不能强制下线，改用卡片底部的「断开连接」  -->
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="本机"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3">
                            <TextBlock
                                x:Name="DeviceErrorText"
                                Margin="0,4,0,0"
                                Style="{StaticResource ErrorTextStyle}"
                                Visibility="Collapsed" />

                            <Border Margin="0,8,0,10" Style="{StaticResource DividerStyle}" />

                            <!--
                                页面级主控：断开本机当前连接。
                                对应门户 userstatus.jsp 底部那个「断开连接」大按钮 ——
                                它断的是本机这条会话（logoff），与设备行里的
                                「点击下线」（踢别人，type=dm）是两件事。
                            -->
                            <Button
                                x:Name="DeviceDisconnectBtn"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnDeviceDisconnectSelfClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--  E8BB = 叉号（关闭 / 断开）。原先用的 E71A 在 Segoe 图标字体里
                                          画出来是一只空心圆角方框，看着像没加载出来的「豆腐块」。  -->
                                    <FontIcon FontSize="13" Glyph="&#xE8BB;" />
                                    <TextBlock x:Name="DeviceDisconnectLabel" FontSize="13" Text="断开连接" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource HintStyle}"
                                Text="断开本机当前连接，巡检会按设置自动重新认证" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  运行日志：填满右侧剩余高度  -->
                <Border
                    x:Name="LogCard"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                    <Grid Padding="16,12,16,12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE9D9;" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="运行日志" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Padding="12,8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="LogScroll"
                                Padding="0,0,8,0"
                                VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <!--  与设置区一致：轨道更宽、拇指更粗  -->
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="14" />
                                    </Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="MinWidth" Value="10" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <ItemsControl x:Name="LogList">
                                    <ItemsControl.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </ItemsControl.ItemContainerTransitions>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,2" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Time}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ══════════ 设置页  ══════════  -->
        <Grid
            x:Name="SettingsPage"
            Grid.Row="1"
            Margin="24,0,24,20"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  页头：返回箭头 + 标题；右端是「即时保存」说明与关于入口。
                  整块与下面的卡片同宽同左沿，右端也收在同一条线上。  -->
            <Grid
                Height="44"
                Margin="0,0,0,8"
                MaxWidth="780">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SettingsBackBtn"
                    Style="{StaticResource NavIconButtonStyle}"
                    IsTabStop="False"
                    Click="OnSettingsBackClicked"
                    ToolTipService.ToolTip="返回">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource PageTitleStyle}"
                    Text="设置" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HintStyle}"
                        Text="改动即时保存" />
                    <Button
                        x:Name="AboutNavBtn"
                        Style="{StaticResource NavIconButtonStyle}"
                        IsTabStop="False"
                        Click="OnAboutNavClicked"
                        ToolTipService.ToolTip="关于">
                        <FontIcon FontSize="14" Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer
                x:Name="SettingsScroll"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <!--  轨道更宽、拇指更粗：默认的细滚动条在这个宽度的设置面板上不好抓  -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="14" />
                    </Style>
                    <Style TargetType="Thumb">
                        <Setter Property="MinWidth" Value="10" />
                    </Style>
                </ScrollViewer.Resources>

                <Grid>
                    <StackPanel MaxWidth="780" Spacing="12">

                    <!--  ────────── 默认账号  ──────────  -->
                    <Border x:Name="AccountCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="16,12,16,12" Spacing="0">
                            <StackPanel
                                Margin="0,0,0,4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE77B;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="默认账号" />
                            </StackPanel>

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="默认学号" />
                                <TextBox
                                    x:Name="AccountBox"
                                    Grid.Column="1"
                                    Style="{StaticResource RowTextBoxStyle}"
                                    PlaceholderText="请输入学号" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="默认密码" />
                                <PasswordBox
                                    x:Name="PwdBox"
                                    Grid.Column="1"
                                    Style="{StaticResource RowPasswordBoxStyle}"
                                    PlaceholderText="校园网密码" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="默认出口" />
                                <ComboBox
                                    x:Name="DefaultOperatorBox"
                                    Grid.Column="1"
                                    Width="220"
                                    SelectedIndex="1">
                                    <ComboBoxItem Content="校园网直连" />
                                    <ComboBoxItem Content="中国移动" />
                                    <ComboBoxItem Content="中国联通" />
                                    <ComboBoxItem Content="中国电信" />
                                </ComboBox>
                            </Grid>

                            <TextBlock
                                Margin="0,6,0,2"
                                Style="{StaticResource HintStyle}"
                                Text="未命中连接规则时，使用默认账号、密码和出口认证。"
                                TextWrapping="Wrap" />

                            <!--  验证码：只在 Portal 要求时出现  -->
                            <StackPanel
                                x:Name="CaptchaPanel"
                                Margin="0,4,0,0"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Border Style="{StaticResource DividerStyle}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="验证码" />
                                        <TextBlock
                                            x:Name="CaptchaHint"
                                            Style="{StaticResource HintStyle}"
                                            Text="按图输入后按回车" />
                                    </StackPanel>
                                    <Button
                                        x:Name="CaptchaRefreshBtn"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="换一张" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="112"
                                        Height="40"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Image
                                            x:Name="CaptchaPic"
                                            Margin="3"
                                            Stretch="Uniform" />
                                    </Border>

                                    <TextBox
                                        x:Name="CaptchaBox"
                                        Grid.Column="1"
                                        Style="{StaticResource FormInputStyle}"
                                        MaxLength="8"
                                        PlaceholderText="输入图片中的字符" />

                                    <Button
                                        x:Name="CaptchaSubmitBtn"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="验证并登录"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ────────── 连接规则  ──────────  -->
                    <Border x:Name="RulesCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="16,12,16,12" Spacing="0">

                            <Grid Margin="0,0,0,6">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE8F1;" />
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="连接规则" />
                                </StackPanel>

                                <Button
                                    x:Name="RulesAddBtn"
                                    Height="28"
                                    Padding="12,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="OnRuleAddClicked"
                                    Content="添加规则"
                                    FontSize="12" />
                            </Grid>

                            <TextBlock
                                x:Name="RulesCurrentLinkText"
                                Style="{StaticResource HintStyle}"
                                Text="当前接入：未知" />

                            <TextBlock
                                x:Name="RulesActiveText"
                                Margin="0,2,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="未命中任何规则，使用默认账号" />

                            <Border Margin="0,8,0,0" Style="{StaticResource DividerStyle}" />

                            <ItemsControl x:Name="RulesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="0,10"
                                            ColumnSpacing="8"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding MatchText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Text="生效"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DetailText}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Height="28"
                                                    Padding="12,0"
                                                    Click="OnRuleEditClicked"
                                                    Content="编辑"
                                                    FontSize="12"
                                                    Tag="{Binding Rule}" />
                                                <Button
                                                    Height="28"
                                                    Padding="12,0"
                                                    Click="OnRuleDeleteClicked"
                                                    Content="删除"
                                                    FontSize="12"
                                                    Tag="{Binding Rule}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="RulesEmptyText"
                                Margin="0,10,0,6"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="还没有连接规则"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="RulesFallbackHint"
                                Margin="0,8,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="没有匹配到规则时，使用默认账号、密码和出口。" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="充分利用教学区有线接入则不记流量这一规则"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  ────────── 巡检与重新认证  ──────────  -->
                    <Border x:Name="IntervalCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="16,12,16,12" Spacing="0">
                            <StackPanel
                                Margin="0,0,0,4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE823;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="巡检与重新认证" />
                            </StackPanel>

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="巡检时长" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="已连接时多久检查一次状态（4–120 秒）" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <NumberBox
                                        x:Name="IntervalBox"
                                        Style="{StaticResource RowNumberBoxStyle}"
                                        Minimum="4"
                                        Maximum="120"
                                        SmallChange="1" />
                                    <TextBlock
                                        x:Name="IntervalUnitText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="秒" />
                                </StackPanel>
                            </Grid>

                            <!--  常用值：贴在控件下方右对齐，与控件右边缘同一条线  -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        x:Name="IntervalQuick4"
                                        Height="26"
                                        Padding="10,0"
                                        Click="OnIntervalQuickClicked"
                                        Content="4 秒"
                                        FontSize="12"
                                        Tag="4" />
                                    <Button
                                        x:Name="IntervalQuick8"
                                        Height="26"
                                        Padding="10,0"
                                        Click="OnIntervalQuickClicked"
                                        Content="8 秒"
                                        FontSize="12"
                                        Tag="8" />
                                    <Button
                                        x:Name="IntervalQuick15"
                                        Height="26"
                                        Padding="10,0"
                                        Click="OnIntervalQuickClicked"
                                        Content="15 秒"
                                        FontSize="12"
                                        Tag="15" />
                                    <Button
                                        x:Name="IntervalQuick30"
                                        Height="26"
                                        Padding="10,0"
                                        Click="OnIntervalQuickClicked"
                                        Content="30 秒"
                                        FontSize="12"
                                        Tag="30" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,8,0,0" Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="按固定间隔重新认证" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="到期断开当前会话再重登，可能短暂断网" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ReauthenticateSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="重新认证间隔" />
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <NumberBox
                                        x:Name="ReauthenticateValueBox"
                                        Width="120"
                                        Minimum="1"
                                        Maximum="8760"
                                        Value="24"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Style="{StaticResource FormInputStyle}" />
                                    <ComboBox
                                        x:Name="ReauthenticateUnitBox"
                                        Width="94"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="小时" />
                                        <ComboBoxItem Content="天" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,2"
                                Style="{StaticResource HintStyle}"
                                Text="巡检负责发现掉线，定时重认证负责主动换会话，两者互不影响。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  ────────── 同时在线设备监测  ──────────  -->
                    <Border x:Name="DeviceGuardCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="16,12,16,12" Spacing="0">

                            <StackPanel
                                Margin="0,0,0,4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE7BA;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="同时在线设备监测" />
                            </StackPanel>

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="启用同时在线设备监测" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="设备数超过阈值，校内和校外连续三轮均不可达才重连" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="DeviceGuardSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="设备数阈值" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="在线设备数（含本机）大于此值才检测" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="DeviceGuardThresholdBox"
                                    Grid.Column="1"
                                    Style="{StaticResource RowNumberBoxStyle}"
                                    Minimum="1"
                                    Maximum="50"
                                    SmallChange="1" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <TextBlock
                                x:Name="DeviceGuardStateText"
                                Margin="0,10,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="守卫未启用" />

                            <TextBlock
                                x:Name="DeviceGuardLastText"
                                Margin="0,2,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="尚未检测" />

                            <StackPanel
                                Margin="0,10,0,2"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="DeviceGuardProbeNowBtn"
                                    Height="30"
                                    Padding="12,0"
                                    Click="OnGuardProbeNowClicked"
                                    Content="立即检测一次"
                                    FontSize="12" />
                                <!--  探测地址、超时这些一年改不上一次，收起来，别占版面  -->
                                <HyperlinkButton
                                    x:Name="GuardAdvancedToggle"
                                    Padding="4,0"
                                    Click="OnGuardAdvancedToggled">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            x:Name="GuardAdvancedToggleText"
                                            FontSize="12"
                                            Text="高级探测设置" />
                                        <FontIcon
                                            x:Name="GuardAdvancedChevron"
                                            FontSize="9"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE70D;" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>

                            <StackPanel
                                x:Name="GuardAdvancedPanel"
                                Margin="0,4,0,0"
                                Spacing="0"
                                Visibility="Collapsed">
                                <Border Style="{StaticResource DividerStyle}" />

                                <Grid MinHeight="52" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="校内探测地址" />
                                        <TextBlock Style="{StaticResource HintStyle}" Text="IP 走 ping，域名默认走 HTTPS" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="DeviceGuardProbeTargetBox"
                                        Grid.Column="1"
                                        Style="{StaticResource RowTextBoxStyle}"
                                        MaxLength="255"
                                        PlaceholderText="www.snnu.edu.cn" />
                                </Grid>

                                <Border Style="{StaticResource DividerStyle}" />

                                <Grid MinHeight="52" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="校外探测地址" />
                                        <TextBlock Style="{StaticResource HintStyle}" Text="校内地址不可达时用它判断是不是全校断网" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="DeviceGuardExternalProbeTargetBox"
                                        Grid.Column="1"
                                        Style="{StaticResource RowTextBoxStyle}"
                                        MaxLength="255"
                                        PlaceholderText="www.baidu.com" />
                                </Grid>

                                <Border Style="{StaticResource DividerStyle}" />

                                <Grid MinHeight="52" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="探测超时" />
                                        <TextBlock Style="{StaticResource HintStyle}" Text="每个地址最多等待此时长" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <NumberBox
                                            x:Name="DeviceGuardTimeoutBox"
                                            Style="{StaticResource RowNumberBoxStyle}"
                                            Minimum="1"
                                            Maximum="30"
                                            SmallChange="1" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ValueTextStyle}"
                                            Text="秒" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ────────── 自动化  ──────────  -->
                    <Border x:Name="BehaviorCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="16,12,16,12" Spacing="0">
                            <StackPanel
                                Margin="0,0,0,4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE945;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="自动化" />
                            </StackPanel>

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="开机自动登录" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="登录系统后静默完成认证" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoStartSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="断线自动重连" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="掉线后自动补认证，失败会逐渐放缓重试" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoReconnectSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="锁屏保持连接" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="锁屏后暂不睡眠，认证会话不断" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="LockKeepSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="52" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="关闭时驻留托盘" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="关窗口不退出，后台继续守候网络" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="TraySwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  ══════════ 关于页（从设置页页头的信息按钮进入）  ══════════  -->
        <Grid
            x:Name="AboutPage"
            Grid.Row="1"
            Margin="24,0,24,20"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Height="44"
                Margin="0,0,0,8"
                MaxWidth="780">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="AboutBackBtn"
                    Style="{StaticResource NavIconButtonStyle}"
                    IsTabStop="False"
                    Click="OnAboutBackClicked"
                    ToolTipService.ToolTip="返回设置">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource PageTitleStyle}"
                    Text="关于" />
            </Grid>

            <ScrollViewer
                x:Name="AboutScroll"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel MaxWidth="780" Spacing="12">

                    <!--  抬头：品牌圆 + 名称 + 版本  -->
                    <Border x:Name="AboutHero" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="20,18,20,18" Spacing="0">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Grid
                                    Width="64"
                                    Height="64"
                                    VerticalAlignment="Top">
                                    <Ellipse Width="64" Height="64" Fill="#1677FF" />
                                    <FontIcon FontSize="34" Foreground="White" Glyph="&#xE701;" />
                                </Grid>

                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="SNNU 校园网助手" />
                                    <TextBlock
                                        x:Name="AboutVersionText"
                                        Style="{StaticResource HintStyle}"
                                        Text="版本 —" />
                                    <TextBlock
                                        Style="{StaticResource HintStyle}"
                                        Text="陕西师范大学 · 校园网自动认证" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Margin="0,16,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="连上校园网后自动完成 Portal 认证。掉线会补认证，锁屏期间保持会话，断网前一般不用管它。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  链接与许可  -->
                    <Border x:Name="AboutLinks" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="16,4,16,4" Spacing="0">
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="认证门户" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Style="{StaticResource InlineLinkStyle}"
                                    Content="202.117.144.205"
                                    NavigateUri="http://202.117.144.205/" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="源代码" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="14">
                                    <HyperlinkButton
                                        Style="{StaticResource InlineLinkStyle}"
                                        Content="GitHub"
                                        NavigateUri="https://github.com/mzh2077/SNNUAutoLogin-GUI" />
                                    <HyperlinkButton
                                        Style="{StaticResource InlineLinkStyle}"
                                        Content="Gitee"
                                        NavigateUri="https://gitee.com/marike_86/SNNUAutoLogin-GUI" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="问题反馈" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="14">
                                    <HyperlinkButton
                                        Style="{StaticResource InlineLinkStyle}"
                                        Content="GitHub Issues"
                                        NavigateUri="https://github.com/mzh2077/SNNUAutoLogin-GUI/issues" />
                                    <HyperlinkButton
                                        Style="{StaticResource InlineLinkStyle}"
                                        Content="Gitee Issues"
                                        NavigateUri="https://gitee.com/marike_86/SNNUAutoLogin-GUI/issues" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="开源许可" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Style="{StaticResource InlineLinkStyle}"
                                    Content="PolyForm Noncommercial 1.0.0"
                                    NavigateUri="https://github.com/mzh2077/SNNUAutoLogin-GUI/blob/main/LICENSE" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="4,2,0,0"
                        Style="{StaticResource HintStyle}"
                        Text="仅限非商业用途。校园网账号与密码只保存在本机，不会上传到任何服务器。"
                        TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
