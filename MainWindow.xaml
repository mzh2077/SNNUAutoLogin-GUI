<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SNNUAutoLogin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SNNUAutoLogin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        配色完全走系统：背景是 Mica（系统壁纸采样），控件前景/描边/填充一律用
        ThemeResource 里的 Fluent 语义刷子，强调色用系统口音色（AccentFillColor*），
        状态色用 SystemFillColor*。不自己从壁纸算颜色。
    -->
    <Grid x:Name="Root">
        <Grid.Resources>

            <!--  bool → Visibility：设备行里「点击下线」与「断开连接」按会话类型二选一  -->
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  设置项：主标题  -->
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!--  设置项：说明文字  -->
            <Style x:Key="RowDescStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  设置项之间的分隔线（与系统设置一致的 1px 细分隔）  -->
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!--
                系统开关：不显示「开 / 关」文字，只留开关本体。
                模板内部为文字预留了 154 的 MinWidth（页面级覆盖该资源无效），
                因此用 Width 精确夹到轨道宽度 —— Width 会盖掉 MinWidth。
                ⚠ 必须用 Width 而不是 MaxWidth：轨道实测 44 宽，MaxWidth=40 会把轨道右侧裁掉一截。
            -->
            <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="OnContent" Value="{x:Null}" />
                <Setter Property="OffContent" Value="{x:Null}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══════════ 标题栏  ══════════  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Margin="0,0,146,0"
            Padding="20,0,0,0"
            Background="Transparent">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <FontIcon
                    x:Name="TitleIcon"
                    FontSize="14"
                    Glyph="&#xE968;" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="校园网自动登录" />

                <Border
                    Width="1"
                    Height="10"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="陕西师范大学" />

                <StackPanel
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Ellipse
                        x:Name="TitleDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        x:Name="TitleState"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="检测中" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  ══════════ 内容区  ══════════  -->
        <Grid
            Grid.Row="1"
            Margin="24,0,24,20"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="336" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ────────── 左：连接状态 + 运行日志  ──────────  -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="StatusCard" Style="{StaticResource CardStyle}">
                    <Grid Padding="24,18,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  卡头：标题 + 自动登录状态  -->
                        <Grid>
                            <TextBlock
                                Style="{StaticResource CardTitleStyle}"
                                Text="连接状态" />

                            <Border
                                x:Name="AutoPill"
                                Padding="8,3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        x:Name="AutoDot"
                                        Width="6"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock
                                        x:Name="AutoLabel"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="自动登录 · 已启用" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  状态主体  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,22,0,0"
                            VerticalAlignment="Top"
                            Spacing="0">

                            <Grid
                                x:Name="RingHost"
                                Width="76"
                                Height="76"
                                HorizontalAlignment="Center">
                                <Ellipse x:Name="HaloRing" Width="76" Height="76" />

                                <ProgressRing
                                    x:Name="BusyRing"
                                    Width="76"
                                    Height="76"
                                    Visibility="Collapsed" />

                                <FontIcon
                                    x:Name="StateIcon"
                                    FontSize="28"
                                    Glyph="&#xE73E;" />
                            </Grid>

                            <TextBlock
                                x:Name="StateTitle"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="正在初始化" />

                            <TextBlock
                                x:Name="StateSubtitle"
                                MaxWidth="272"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="正在读取本机状态…"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  页脚：明细 + 操作  -->
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,18,0,0"
                            Spacing="0">
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="账号" />
                                <TextBlock
                                    x:Name="AccText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="—" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="出口 IP" />
                                <TextBlock
                                    x:Name="IpText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="—" />
                            </Grid>

                            <Border Margin="0,10,0,0" Style="{StaticResource DividerStyle}" />

                            <Grid Margin="0,10,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="ConnectBtn"
                                    Height="34"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="ConnectIcon" FontSize="13" Glyph="&#xE7E8;" />
                                        <TextBlock
                                            x:Name="ConnectLabel"
                                            FontSize="13"
                                            Text="立即登录" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="RefreshBtn"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    ToolTipService.ToolTip="刷新状态">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  运行日志：填满左侧剩余高度  -->
                <Border
                    x:Name="LogCard"
                    Grid.Row="1"
                    Style="{StaticResource CardStyle}">
                    <Grid Padding="20,14,20,14" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE9D9;" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="运行日志" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Padding="12,8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="LogScroll"
                                Padding="0,0,6,0"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LogList">
                                    <ItemsControl.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </ItemsControl.ItemContainerTransitions>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Padding="0,2"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="10.5"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Time}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  ────────── 右：设置  ──────────  -->
            <ScrollViewer
                x:Name="SettingsScroll"
                Grid.Column="1"
                Padding="0,0,0,0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsPanel" Spacing="12">

                    <!--  在线设备：门户在线控制页里的设备表格  -->
                    <Border x:Name="DeviceCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="20,14,20,14" Spacing="0">

                            <Grid>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE968;" />
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="在线设备" />
                                </StackPanel>

                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <ComboBox
                                        x:Name="DevicePortBox"
                                        Width="96"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        ToolTipService.ToolTip="接入端口" />

                                    <Button
                                        x:Name="DeviceRefreshBtn"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        ToolTipService.ToolTip="刷新设备列表">
                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  列表说明：当前端口的在线控制  -->
                            <TextBlock
                                x:Name="DeviceSummary"
                                Margin="0,8,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="尚未加载" />

                            <Border Style="{StaticResource DividerStyle}" />

                            <ItemsControl x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  第一行：设备名 + IP + 状态  -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding DisplayName}" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Status}" />
                                            </Grid>

                                            <!--  第二行：明细 + 操作  -->
                                            <Grid
                                                Grid.Row="1"
                                                Margin="14,5,0,0"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Ip}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding Detail}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6">

                                                    <!--  别的会话：强制下线（门户里的「强制下线」）  -->
                                                    <Button
                                                        Click="OnDeviceOfflineClicked"
                                                        Content="点击下线"
                                                        FontSize="12"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding CanForceOffline, Converter={StaticResource BoolToVisibility}}" />

                                                    <!--  本机当前这条连接不能强制下线，改用卡片底部的「断开连接」  -->
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="本机"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  空态 / 错误态  -->
                            <TextBlock
                                x:Name="DeviceEmptyText"
                                Margin="0,12,0,4"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="暂无在线设备"
                                Visibility="Collapsed" />

                            <Border Style="{StaticResource DividerStyle}" />

                            <TextBlock
                                x:Name="DeviceErrorText"
                                Margin="0,8,0,0"
                                FontSize="11.5"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <!--
                                页面级主控：断开本机当前连接。
                                对应门户 userstatus.jsp 底部那个「断开连接」大按钮 ——
                                它断的是本机这条会话（logoff），与设备行里的
                                「点击下线」（踢别人，type=dm）是两件事。
                            -->
                            <Button
                                x:Name="DeviceDisconnectBtn"
                                Margin="0,12,0,2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnDeviceDisconnectSelfClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="13" Glyph="&#xE71A;" />
                                    <TextBlock x:Name="DeviceDisconnectLabel" FontSize="13" Text="断开连接" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource HintStyle}"
                                Text="断开本机当前连接，巡检会按设置自动重新认证" />

                        </StackPanel>
                    </Border>

                    <!--  1.4.0 起移除了网络加速：只在检测到旧版残留时出现，一键还原  -->
                    <Border
                        x:Name="LegacyHostsBar"
                        Padding="14,9,8,9"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE946;"
                                VerticalAlignment="Center" />

                            <TextBlock
                                x:Name="LegacyHostsText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="LegacyCleanBtn"
                                Grid.Column="2"
                                Height="28"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Content="还原解析"
                                FontSize="12"
                                Style="{StaticResource AccentButtonStyle}" />

                            <Button
                                x:Name="LegacyDismissBtn"
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="本次不再提示">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  账号与出口  -->
                    <Border x:Name="AccountCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="20,14,20,14" Spacing="0">
                            <StackPanel
                                Margin="0,0,0,10"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE77B;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="账号与出口" />
                            </StackPanel>

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="学号" />
                                <TextBox
                                    x:Name="AccountBox"
                                    Grid.Column="1"
                                    Width="250"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Microsoft YaHei UI"
                                    PlaceholderText="请输入学号" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="密码" />
                                <PasswordBox
                                    x:Name="PwdBox"
                                    Grid.Column="1"
                                    Width="250"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Microsoft YaHei UI"
                                    PasswordRevealMode="Peek"
                                    PlaceholderText="校园网密码" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowTitleStyle}"
                                    Text="网络出口" />
                                <ComboBox
                                    x:Name="OperatorBox"
                                    Grid.Column="1"
                                    Width="250"
                                    VerticalAlignment="Center">
                                    <ComboBoxItem Content="校园网直连" />
                                    <ComboBoxItem Content="中国移动" />
                                    <ComboBoxItem Content="中国联通" />
                                    <ComboBoxItem Content="中国电信" />
                                </ComboBox>
                            </Grid>

                            <TextBlock
                                x:Name="OpHint"
                                Margin="0,8,0,0"
                                Style="{StaticResource HintStyle}"
                                Text="校园网为校内直连出口；移动 / 联通 / 电信为运营商代拨出口。" />

                            <!--  验证码：只在 Portal 要求时出现  -->
                            <StackPanel
                                x:Name="CaptchaPanel"
                                Margin="0,4,0,0"
                                Spacing="6"
                                Visibility="Collapsed">
                                <Border Style="{StaticResource DividerStyle}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="验证码" />
                                        <TextBlock
                                            x:Name="CaptchaHint"
                                            Style="{StaticResource RowDescStyle}"
                                            Text="按图输入后按回车" />
                                    </StackPanel>
                                    <Button
                                        x:Name="CaptchaRefreshBtn"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="换一张" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="112"
                                        Height="40"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Image
                                            x:Name="CaptchaPic"
                                            Margin="3"
                                            Stretch="Uniform" />
                                    </Border>

                                    <TextBox
                                        x:Name="CaptchaBox"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas, Microsoft YaHei UI"
                                        MaxLength="8"
                                        PlaceholderText="输入图片中的字符" />

                                    <Button
                                        x:Name="CaptchaSubmitBtn"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="验证并登录"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  自动化  -->
                    <Border x:Name="BehaviorCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="20,14,20,14" Spacing="0">
                            <StackPanel
                                Margin="0,0,0,10"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE945;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="自动化" />
                            </StackPanel>

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="开机自动登录" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="登录系统后静默完成认证" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoStartSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="断线自动重连" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="掉线后自动补认证，失败会逐渐放缓重试" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoReconnectSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="锁屏保持连接" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="锁屏后暂不睡眠，认证会话不断" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="LockKeepSwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="关闭时驻留托盘" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="关窗口不退出，后台继续守候网络" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="TraySwitch"
                                    Grid.Column="1"
                                    Style="{StaticResource RowToggleStyle}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="巡检间隔" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="已连接时多久检查一次状态" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="IntervalBox"
                                    Grid.Column="1"
                                    Width="120"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  关于  -->
                    <Border x:Name="AboutCard" Style="{StaticResource CardStyle}">
                        <StackPanel Padding="20,14,20,14" Spacing="0">
                            <StackPanel
                                Margin="0,0,0,8"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE946;" />
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="关于" />
                            </StackPanel>

                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="认证门户" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="202.117.144.205:8603" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="配置与凭据" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="%LOCALAPPDATA%\SNNUAutoLogin" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />

                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="程序版本" />
                                <TextBlock
                                    x:Name="VersionText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ValueTextStyle}"
                                    Text="—" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
