<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SNNUAutoLogin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SNNUAutoLogin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Windows 11 / WinUI 3 版式：
          · NavigationView 左紧凑栏（48），页面四个：主页 / 设置 / 高级设置 / 关于（页脚）；
          · 内容单列，MaxWidth 640 居中，页面左右各留 24；
          · 4 / 8 网格：分组间距 24、卡片间距 4、卡片内边距 16、圆角 8；
          · 字号：28 页标题 / 14 分组标题 / 14 行标题 / 12 说明 / 12 标签。
    -->
    <Grid x:Name="Root" IsTabStop="True">
        <Grid.Resources>
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlHighlightAccentBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush" />

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!--  ══ 间距与尺寸 ══  -->
            <x:Double x:Key="PagePadding">24</x:Double>
            <x:Double x:Key="CardPadding">16</x:Double>
            <x:Double x:Key="RowHeight">52</x:Double>

            <!--  ══ 卡片 ══  -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!--  Windows 11 设置应用做法：每一项一张独立卡片，卡片间距 4，分组间距 24  -->
            <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!--  逻辑分组锚点：代码里靠 x:Name 取到它做动画，视觉上只是透明容器  -->
            <Style x:Key="GroupCardStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="16,0,16,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!--  ══ 文字层级 ══  -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <!--  BodyStrong：14 / SemiBold，分组之间留 24  -->
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="2,24,0,8" />
            </Style>

            <!--  首页第一组不需要顶部 24  -->
            <Style x:Key="GroupHeaderFirstStyle" TargetType="TextBlock" BasedOn="{StaticResource GroupHeaderStyle}">
                <Setter Property="Margin" Value="2,0,0,8" />
            </Style>

            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RowDescStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  所有灰色说明统一用 Secondary，保证明暗两色下对比度都够  -->
            <Style x:Key="HintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="MetaValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SectionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowInputStyle" TargetType="Control">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!--  设置页输入控件最宽 240，窄窗口自动收缩，标题不会被挤出  -->
            <Style x:Key="RowTextBoxStyle" BasedOn="{StaticResource RowInputStyle}" TargetType="TextBox">
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="RowPasswordBoxStyle" BasedOn="{StaticResource RowInputStyle}" TargetType="PasswordBox">
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="PasswordRevealMode" Value="Peek" />
            </Style>

            <Style x:Key="RowComboBoxStyle" BasedOn="{StaticResource RowInputStyle}" TargetType="ComboBox">
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!--  主页快捷设置里的出口框：窄版，避免挤占卡片  -->
            <Style x:Key="QuickComboBoxStyle" BasedOn="{StaticResource RowInputStyle}" TargetType="ComboBox">
                <Setter Property="Width" Value="132" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="RowNumberBoxStyle" BasedOn="{StaticResource RowInputStyle}" TargetType="NumberBox">
                <Setter Property="Width" Value="96" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            </Style>

            <!--  开关自带的 Content 就在轨道左边，用它显示「开 / 关」；文字不在模板右侧预留空位  -->
            <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToggleLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="InlineLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Foreground" Value="{ThemeResource InlineLinkBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SmallButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══════════ 标题栏  ══════════  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Margin="0,0,138,0"
            Padding="12,0,0,0"
            Background="Transparent"
            SizeChanged="OnTitleBarSized">

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    x:Name="TitleIcon"
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/app_16.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="SNNU 校园网助手" />
            </StackPanel>
        </Grid>

        <!--  ══════════ 导航骨架  ══════════  -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            Background="Transparent"
            CompactModeThresholdWidth="0"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="10000"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="200"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavHome"
                    Content="主页"
                    IsSelected="True"
                    Tag="home"
                    ToolTipService.ToolTip="主页">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavSettings"
                    Content="设置"
                    Tag="settings"
                    ToolTipService.ToolTip="设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="NavAdvanced"
                    Content="高级设置"
                    Tag="advanced"
                    ToolTipService.ToolTip="高级设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="NavAbout"
                    Content="关于"
                    Tag="about"
                    ToolTipService.ToolTip="关于">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <!--  ══════════════════════════ 主页  ══════════════════════════  -->
                <ScrollViewer
                    x:Name="HomePage"
                    Padding="16,12,16,16"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        x:Name="HomeHost"
                        Width="{Binding ViewportWidth, ElementName=HomePage}"
                        MaxWidth="640"
                        HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!--  操作提示：贴边收起、下线结果等一次性消息  -->
                            <InfoBar
                                x:Name="OperationNotice"
                                Margin="0,0,0,8"
                                IsOpen="False"
                                IsClosable="True" />

                            <!--  旧版 hosts 残留：只在检测到时出现  -->
                            <Border
                                x:Name="LegacyHostsBar"
                                Margin="0,0,0,8"
                                Padding="12,8,8,8"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                        Glyph="&#xE946;" />

                                    <TextBlock
                                        x:Name="LegacyHostsText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        x:Name="LegacyCleanBtn"
                                        Grid.Column="2"
                                        Height="26"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        Content="还原"
                                        FontSize="12"
                                        Style="{StaticResource AccentButtonStyle}" />

                                    <Button
                                        x:Name="LegacyDismissBtn"
                                        Grid.Column="3"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="本次不再提示">
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!--  ────── 首次使用：登录引导  ──────  -->
                            <Border
                                x:Name="GuideCard"
                                Margin="0,0,0,8"
                                Style="{StaticResource CardStyle}"
                                Visibility="Collapsed">
                                <StackPanel Padding="16" Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="先填一下校园网账号" />
                                        <TextBlock Style="{StaticResource RowDescStyle}" Text="填好点下面的按钮，连上以后就不用管了。" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="学号" />
                                        <TextBox
                                            x:Name="GuideAccountBox"
                                            MinHeight="32"
                                            PlaceholderText="请输入学号" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="密码" />
                                        <PasswordBox
                                            x:Name="GuidePwdBox"
                                            MinHeight="32"
                                            PasswordRevealMode="Peek"
                                            PlaceholderText="校园网密码" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource MetaLabelStyle}" Text="出口运营商" />
                                        <ComboBox
                                            x:Name="GuideOperatorBox"
                                            HorizontalAlignment="Stretch"
                                            MinHeight="32"
                                            SelectedIndex="1">
                                            <ComboBoxItem Content="校园网直连" />
                                            <ComboBoxItem Content="中国移动" />
                                            <ComboBoxItem Content="中国联通" />
                                            <ComboBoxItem Content="中国电信" />
                                        </ComboBox>
                                    </StackPanel>

                                    <Button
                                        x:Name="GuideSaveBtn"
                                        HorizontalAlignment="Stretch"
                                        Content="保存并连接"
                                        Style="{StaticResource AccentButtonStyle}" />

                                    <TextBlock
                                        x:Name="GuideErrorText"
                                        Style="{StaticResource ErrorTextStyle}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!--  ────── 状态卡  ──────  -->
                            <Border
                                x:Name="StatusCard"
                                Margin="0,0,0,24"
                                Style="{StaticResource CardStyle}">
                                <StackPanel Padding="16" Spacing="0">

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            x:Name="RingHost"
                                            Width="44"
                                            Height="44"
                                            VerticalAlignment="Top">
                                            <Ellipse x:Name="HaloRing" Width="44" Height="44" />
                                            <ProgressRing
                                                x:Name="BusyRing"
                                                Width="24"
                                                Height="24"
                                                IsActive="False"
                                                Visibility="Collapsed" />
                                            <FontIcon x:Name="StateIcon" FontSize="18" Glyph="&#xE73E;" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                x:Name="StateTitle"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="正在初始化" />
                                            <TextBlock
                                                x:Name="StateSubtitle"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="正在读取本机状态…"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,16,0,0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="当前账号" />
                                            <TextBlock x:Name="CurrentAccountText" Style="{StaticResource MetaValueStyle}" Text="—" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="CurrentOperatorLabel" Style="{StaticResource MetaLabelStyle}" Text="当前出口" />
                                            <TextBlock x:Name="CurrentOperatorText" Style="{StaticResource MetaValueStyle}" Text="—" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  IP、连接时长和巡检倒计时  -->
                                    <Grid Margin="0,16,0,0" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="IpCell">
                                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="本机 IP" />
                                            <TextBlock
                                                x:Name="IpText"
                                                Style="{StaticResource MetaValueStyle}"
                                                Text="—" />
                                        </StackPanel>

                                        <StackPanel x:Name="DurationCell" Grid.Column="1">
                                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="已连接时长" />
                                            <TextBlock
                                                x:Name="DurationText"
                                                Style="{StaticResource MetaValueStyle}"
                                                Text="—" />
                                        </StackPanel>

                                        <StackPanel x:Name="CountdownCell" Grid.Column="2">
                                            <TextBlock Style="{StaticResource MetaLabelStyle}" Text="下次检查" />
                                            <TextBlock
                                                x:Name="CountdownText"
                                                Style="{StaticResource MetaValueStyle}"
                                                Text="—" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  验证码：只在门户要求时展开  -->
                                    <StackPanel
                                        x:Name="CaptchaPanel"
                                        Margin="0,12,0,0"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                        <Border Margin="0,0,0,2" Style="{StaticResource DividerStyle}" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="需要验证码" />
                                                <TextBlock
                                                    x:Name="CaptchaHint"
                                                    Style="{StaticResource HintStyle}"
                                                    Text="按图输入后按回车" />
                                            </StackPanel>
                                            <Button
                                                x:Name="CaptchaRefreshBtn"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SmallButtonStyle}"
                                                Content="换一张" />
                                        </Grid>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="104"
                                                Height="38"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <Image
                                                    x:Name="CaptchaPic"
                                                    Margin="3"
                                                    Stretch="Uniform" />
                                            </Border>

                                            <TextBox
                                                x:Name="CaptchaBox"
                                                Grid.Column="1"
                                                MinHeight="32"
                                                VerticalAlignment="Center"
                                                MaxLength="8"
                                                PlaceholderText="输入图片中的字符" />

                                            <Button
                                                x:Name="CaptchaSubmitBtn"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Content="验证并登录"
                                                Style="{ThemeResource AccentButtonStyle}" />
                                        </Grid>
                                    </StackPanel>

                                    <!--  主操作只有一个；断开、切换出口收进「更多」  -->
                                    <Grid Margin="0,16,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            x:Name="ConnectBtn"
                                            MinHeight="32"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon x:Name="ConnectIcon" FontSize="12" Glyph="&#xE7E8;" />
                                                <TextBlock
                                                    x:Name="ConnectLabel"
                                                    FontSize="14"
                                                    Text="立即连接" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            x:Name="MoreBtn"
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            ToolTipService.ToolTip="更多操作">
                                            <FontIcon FontSize="13" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem
                                                        x:Name="RefreshItem"
                                                        Text="刷新状态"
                                                        Click="OnRefreshMenuClicked">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE72C;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        x:Name="SwitchOutletItem"
                                                        Text="切换出口运营商"
                                                        Click="OnSwitchOutletClicked" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        x:Name="DisconnectItem"
                                                        Text="断开本机连接"
                                                        Click="OnDisconnectMenuClicked" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        x:Name="StatusNotice"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource HintStyle}"
                                        Visibility="Collapsed"
                                        AutomationProperties.LiveSetting="Polite" />

                                    <HyperlinkButton
                                        x:Name="UpdateLink"
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource InlineLinkStyle}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!--  ────── 在线设备  ──────  -->
                            <Expander
                                x:Name="DeviceCard"
                                Margin="0,0,0,24"
                                Style="{StaticResource SettingsExpanderStyle}"
                                Expanding="OnDeviceCardExpanding"
                                IsExpanded="True">
                                <Expander.Header>
                                    <Grid Padding="4,8,4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE977;" />

                                        <TextBlock
                                            x:Name="DeviceSummary"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="在线设备：正在读取…"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" x:Name="DeviceRefreshBtn"
                                            Style="{StaticResource SmallButtonStyle}" Content="刷新"
                                            Click="OnDevicesRefreshClicked" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Padding="16,0,16,8">
                                    <TextBlock x:Name="DeviceEmptyText" Style="{StaticResource HintStyle}" Text="尚未读取，点击刷新查看在线设备。" />

                                    <ScrollViewer
                                        MaxHeight="180"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DeviceList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Padding="0,8"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="1">
                                                            <TextBlock
                                                                FontSize="13"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Ip}" />
                                                            <TextBlock FontSize="11" Text="{Binding Detail}" TextWrapping="Wrap"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </StackPanel>

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding Status}" />
                                                            <Button
                                                                Click="OnDeviceOfflineClicked"
                                                                Content="下线"
                                                                Style="{StaticResource SmallButtonStyle}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanForceOffline, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="本机"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Grid
                                        x:Name="DeviceErrorRow"
                                        Margin="0,4,0,0"
                                        ColumnSpacing="8"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="DeviceErrorText"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource HintStyle}"
                                            Text="暂时读取不到设备信息" />
                                        <HyperlinkButton
                                            x:Name="DeviceRetryBtn"
                                            Grid.Column="1"
                                            Style="{StaticResource InlineLinkStyle}"
                                            Content="重试" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!--  ────── 快捷设置：四项各一张独立卡片，间距 4  ──────  -->
                            <StackPanel Margin="0,0,0,24" Spacing="4">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE77B;" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="账号" />
                                            <TextBlock
                                                x:Name="AccText"
                                                Style="{StaticResource RowDescStyle}"
                                                Text="还没填学号" />
                                        </StackPanel>
                                        <Button
                                            x:Name="QuickEditAccountBtn"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmallButtonStyle}"
                                            Content="修改" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE774;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource RowTitleStyle}"
                                            Text="出口运营商" />
                                        <ComboBox
                                            x:Name="QuickOperatorBox"
                                            Grid.Column="2"
                                            Style="{StaticResource QuickComboBoxStyle}"
                                            SelectedIndex="1">
                                            <ComboBoxItem Content="校园网直连" />
                                            <ComboBoxItem Content="中国移动" />
                                            <ComboBoxItem Content="中国联通" />
                                            <ComboBoxItem Content="中国电信" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE7E8;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource RowTitleStyle}"
                                            Text="开机自动启动" />
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock x:Name="QuickAutoStartState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                            <ToggleSwitch x:Name="QuickAutoStartSwitch" Style="{StaticResource RowToggleStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE895;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource RowTitleStyle}"
                                            Text="掉线自动重连" />
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock x:Name="QuickReconnectState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                            <ToggleSwitch x:Name="QuickReconnectSwitch" Style="{StaticResource RowToggleStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!--  ────── 最近事件  ──────  -->
                            <Expander
                                x:Name="LogCard"
                                Style="{StaticResource SettingsExpanderStyle}"
                                IsExpanded="False">
                                <Expander.Header>
                                    <Grid Padding="4,8,4,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE8FD;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="最近事件" />
                                        <TextBlock
                                            x:Name="LogBadge"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource HintStyle}"
                                            Text="0 条" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Padding="16,0,16,8" Spacing="4">
                                    <StackPanel
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <HyperlinkButton
                                            x:Name="LogCopyBtn"
                                            Style="{StaticResource InlineLinkStyle}"
                                            Content="复制" />
                                        <HyperlinkButton
                                            x:Name="LogClearBtn"
                                            Style="{StaticResource InlineLinkStyle}"
                                            Content="清空" />
                                    </StackPanel>

                                    <ScrollViewer
                                        x:Name="LogScroll"
                                        MaxHeight="200"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="LogEvents">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,6" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding Time}" />

                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Text}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding CountText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock
                                        x:Name="LogEmptyText"
                                        Style="{StaticResource HintStyle}"
                                        Text="掉线、重连、失败会记录在这里" />
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!--  ══════════════════════════ 设置  ══════════════════════════  -->
                <ScrollViewer
                    x:Name="SettingsPage"
                    Padding="16,12,16,16"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <Grid x:Name="SettingsHost"
                        Width="{Binding ViewportWidth, ElementName=SettingsPage}"
                        MaxWidth="640"
                        HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Stretch">

                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />

                            <TextBlock Style="{StaticResource GroupHeaderFirstStyle}" Text="账号与出口" />

                            <Border x:Name="AccountCard" Style="{StaticResource GroupCardStyle}">
                                <StackPanel Spacing="4">
                                    <!--  学号：宽态标题与输入同一行，输入固定 240 靠右  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid MinHeight="44" ColumnSpacing="12">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition x:Name="AccountColumn" Width="240" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon
                                                x:Name="AccountIcon"
                                                Grid.RowSpan="2"
                                                Style="{StaticResource SectionIconStyle}"
                                                Glyph="&#xE77B;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="学号" />
                                            <TextBox
                                                x:Name="AccountBox"
                                                Grid.Column="2"
                                                Width="240"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTextBoxStyle}"
                                                PlaceholderText="学号" />
                                        </Grid>
                                    </Border>

                                    <!--  密码：眼睛按钮放在输入框内部右侧  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid MinHeight="44" ColumnSpacing="12">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition x:Name="PasswordColumn" Width="240" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon
                                                x:Name="PwdIcon"
                                                Grid.RowSpan="2"
                                                Style="{StaticResource SectionIconStyle}"
                                                Glyph="&#xE72E;" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="密码" />
                                                <TextBlock Style="{StaticResource RowDescStyle}" Text="仅保存在本机，不会上传" />
                                            </StackPanel>

                                            <Grid
                                                x:Name="PasswordInputHost"
                                                Grid.Column="2"
                                                Width="240"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <PasswordBox
                                                    x:Name="PwdBox"
                                                    MinHeight="32"
                                                    Padding="12,0,36,0"
                                                    CornerRadius="4"
                                                    PasswordRevealMode="Hidden"
                                                    PlaceholderText="密码" />
                                                <Button
                                                    x:Name="PwdRevealBtn"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="0,0,3,0"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTipService.ToolTip="显示密码"
                                                    Click="OnPwdRevealClicked">
                                                    <FontIcon
                                                        x:Name="PwdRevealIcon"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE890;" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  出口运营商  -->
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid MinHeight="44" ColumnSpacing="12">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition x:Name="OperatorColumn" Width="240" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon
                                                x:Name="OperatorIcon"
                                                Grid.RowSpan="2"
                                                Style="{StaticResource SectionIconStyle}"
                                                Glyph="&#xE774;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="出口运营商" />
                                            <ComboBox
                                                x:Name="DefaultOperatorBox"
                                                Grid.Column="2"
                                                Width="240"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowComboBoxStyle}"
                                                SelectedIndex="1">
                                                <ComboBoxItem Content="校园网直连" />
                                                <ComboBoxItem Content="中国移动" />
                                                <ComboBoxItem Content="中国联通" />
                                                <ComboBoxItem Content="中国电信" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="2,24,0,8"
                                Style="{StaticResource GroupHeaderStyle}"
                                Text="自动连接与重连" />

                            <Border x:Name="BehaviorCard" Style="{StaticResource GroupCardStyle}">
                                <StackPanel Spacing="4">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE895;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="掉线自动重连" />
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock x:Name="AutoReconnectState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                                <ToggleSwitch x:Name="AutoReconnectSwitch" Style="{StaticResource RowToggleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE7E8;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="开机自动启动" />
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock x:Name="AutoStartState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                                <ToggleSwitch x:Name="AutoStartSwitch" Style="{StaticResource RowToggleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE945;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="锁屏时保持在线" />
                                                <TextBlock Style="{StaticResource RowDescStyle}" Text="锁屏后阻止系统睡眠" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock x:Name="LockKeepState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                                <ToggleSwitch x:Name="LockKeepSwitch" Style="{StaticResource RowToggleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE73F;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="关闭窗口时最小化到托盘" />
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock x:Name="TrayState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                                <ToggleSwitch x:Name="TraySwitch" Style="{StaticResource RowToggleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!--  ══════════════════════════ 高级设置  ══════════════════════════  -->
                <ScrollViewer
                    x:Name="AdvancedPage"
                    Padding="16,12,16,16"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <Grid x:Name="AdvancedHost"
                        Width="{Binding ViewportWidth, ElementName=AdvancedPage}"
                        MaxWidth="640"
                        HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Stretch">

                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="高级设置" />

                            <TextBlock Style="{StaticResource GroupHeaderFirstStyle}" Text="连接" />

                            <StackPanel Spacing="4">

                                <Border x:Name="IntervalCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE916;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource RowTitleStyle}"
                                            Text="在线检查间隔" />
                                        <Grid
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,8,0,0"
                                            ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider
                                                x:Name="IntervalSlider"
                                                MinWidth="120"
                                                VerticalAlignment="Center"
                                                IsThumbToolTipEnabled="False"
                                                Maximum="120"
                                                Minimum="4"
                                                StepFrequency="1" />
                                            <TextBlock
                                                x:Name="IntervalValueText"
                                                Grid.Column="1"
                                                MinWidth="44"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="15 秒"
                                                TextAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Expander
                                    x:Name="ReauthExpander"
                                    Style="{StaticResource SettingsExpanderStyle}">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="4,8,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE823;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="定时重新认证" />
                                                <TextBlock Style="{StaticResource RowDescStyle}" Text="按固定间隔重新登录，期间可能短暂断网" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock x:Name="ReauthState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                                <ToggleSwitch x:Name="ReauthenticateSwitch" Style="{StaticResource RowToggleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel x:Name="ReauthRows" Padding="16,0,16,8">
                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="52"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE9F3;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource RowTitleStyle}"
                                                    Text="重新认证间隔" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <NumberBox
                                                        x:Name="ReauthenticateValueBox"
                                                        Width="72"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        MinHeight="32"
                                                        MinWidth="0"
                                                        SpinButtonPlacementMode="Compact" />
                                                    <ComboBox
                                                        x:Name="ReauthenticateUnitBox"
                                                        Width="80"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        MinHeight="32"
                                                        SelectedIndex="0">
                                                        <ComboBoxItem Content="小时" />
                                                        <ComboBoxItem Content="天" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource GroupHeaderStyle}"
                                Text="同时在线设备" />

                            <StackPanel Spacing="4">

                                <Expander
                                    x:Name="DeviceGuardCard"
                                    Style="{StaticResource SettingsExpanderStyle}">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="4,8,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE977;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="同时在线设备监测" />
                                                <TextBlock Style="{StaticResource RowDescStyle}" Text="设备超限且连续三轮网络不通时重新登录" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock x:Name="GuardState" Style="{StaticResource ToggleLabelStyle}" Text="关" />
                                                <ToggleSwitch x:Name="DeviceGuardSwitch" Style="{StaticResource RowToggleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel x:Name="GuardRows" Padding="16,0,16,8">

                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="52"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE950;" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="设备数上限" />
                                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="包含本机" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="DeviceGuardThresholdBox"
                                                    Grid.Column="2"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Style="{StaticResource RowNumberBoxStyle}"
                                                    Minimum="1"
                                                    Maximum="50" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="52"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE9D9;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource RowTitleStyle}"
                                                    Text="上次检测" />
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="12">
                                                    <TextBlock
                                                        x:Name="DeviceGuardStateText"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource HintStyle}"
                                                        Text="尚未检测" />
                                                    <Button
                                                        x:Name="DeviceGuardProbeNowBtn"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SmallButtonStyle}"
                                                        Content="立即检测"
                                                        Click="OnGuardProbeNowClicked" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            x:Name="DeviceGuardLastText"
                                            Margin="32,4,0,0"
                                            Style="{StaticResource HintStyle}"
                                            Text=""
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>

                                <!--  连不上时的检查项：独立展开项，不嵌在别的卡片里  -->
                                <Expander
                                    x:Name="GuardAdvancedExpander"
                                    Style="{StaticResource SettingsExpanderStyle}"
                                    IsExpanded="False">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="4,8,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE774;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="网络连通性检测" />
                                                <TextBlock Style="{StaticResource RowDescStyle}" Text="用于判断当前网络是否可用" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Padding="16,0,16,8">

                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="52"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="ProbeInternalColumn" Width="240" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <FontIcon
                                                    x:Name="ProbeInternalIcon"
                                                    Grid.RowSpan="2"
                                                    Style="{StaticResource SectionIconStyle}"
                                                    Glyph="&#xE968;" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="校内网址" />
                                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="留空用默认地址" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="DeviceGuardProbeTargetBox"
                                                    Grid.Column="2"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Width="240"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MinHeight="32"
                                                    PlaceholderText="留空使用默认" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="52"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="ProbeExternalColumn" Width="240" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <FontIcon
                                                    x:Name="ProbeExternalIcon"
                                                    Grid.RowSpan="2"
                                                    Style="{StaticResource SectionIconStyle}"
                                                    Glyph="&#xE839;" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="外网网址" />
                                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="判断是否真的断网" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="DeviceGuardExternalProbeTargetBox"
                                                    Grid.Column="2"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Width="240"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    MinHeight="32"
                                                    PlaceholderText="用来判断是否真的断网" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="52"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE8EF;" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="超时" />
                                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="单次探测等待秒数" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <NumberBox
                                                        x:Name="DeviceGuardTimeoutBox"
                                                        Width="96"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        MinWidth="0"
                                                        MinHeight="32"
                                                        Maximum="30"
                                                        Minimum="1"
                                                        SpinButtonPlacementMode="Compact" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MetaLabelStyle}"
                                                        Text="秒" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            x:Name="ProbePortText"
                                            Margin="32,6,0,0"
                                            Style="{StaticResource HintStyle}"
                                            Text="当前连接入口 —" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource GroupHeaderStyle}"
                                Text="连接规则" />

                            <StackPanel Spacing="4">
                                <Expander x:Name="RulesCard" Style="{StaticResource SettingsExpanderStyle}">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="4,8,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE8F1;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="按网络选账号" />
                                            <Button
                                                x:Name="RulesAddBtn"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SmallButtonStyle}"
                                                Click="OnRuleAddClicked"
                                                Content="添加规则" />
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Padding="16,0,16,8" Spacing="0">
                                        <Border
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid
                                                MinHeight="48"
                                                Padding="0,6"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource RowTitleStyle}"
                                                    Text="当前接入" />
                                                <TextBlock
                                                    x:Name="RulesCurrentLinkText"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource HintStyle}"
                                                    Text="读取中…"
                                                    TextAlignment="Right" />
                                            </Grid>
                                        </Border>

                                        <TextBlock
                                            x:Name="RulesActiveText"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource HintStyle}"
                                            Text="" />

                                        <StackPanel x:Name="RulesEmptyPanel" Margin="0,8,0,0">
                                            <TextBlock
                                                x:Name="RulesEmptyText"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="比如宿舍和教学楼用不同账号。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel x:Name="RulesListPanel" Margin="0,4,0,0">
                                            <ItemsControl x:Name="RulesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Padding="0,8"
                                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Spacing="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock
                                                                        FontSize="13"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="{Binding MatchText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <Border
                                                                        Padding="5,1"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                                        CornerRadius="3"
                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                            Text="使用中" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding DetailText}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal"
                                                                Spacing="2">
                                                                <Button
                                                                    Click="OnRuleEditClicked"
                                                                    Style="{StaticResource SmallButtonStyle}"
                                                                    Content="编辑"
                                                                    Tag="{Binding Rule}" />
                                                                <Button
                                                                    Click="OnRuleDeleteClicked"
                                                                    Style="{StaticResource SmallButtonStyle}"
                                                                    Content="删除"
                                                                    Tag="{Binding Rule}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="RulesFallbackHint"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource HintStyle}"
                                            Text="没命中任何规则时，就用上面的默认账号。"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource GroupHeaderStyle}"
                                Text="调试" />

                            <StackPanel Spacing="4">
                                <Expander
                                    x:Name="RawLogExpander"
                                    Style="{StaticResource SettingsExpanderStyle}"
                                    IsExpanded="False">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="4,8,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource SectionIconStyle}" Glyph="&#xE8A5;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="原始日志" />
                                                <TextBlock Style="{StaticResource RowDescStyle}" Text="最近 2000 条逐条记录，含请求、响应、耗时和异常详情" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Padding="16,0,16,12" Spacing="8">
                                        <Border
                                            Height="1"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <ScrollViewer
                                            x:Name="RawLogScroll"
                                            MaxHeight="220"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ListView x:Name="LogList" Height="220" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="0,3" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="144" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Time}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="11.5"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding Text}"
                                                                TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </ScrollViewer>

                                        <HyperlinkButton
                                            x:Name="RawLogCopyBtn"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource InlineLinkStyle}"
                                            Content="复制全部" />
                                        <HyperlinkButton x:Name="RawLogOpenBtn" HorizontalAlignment="Left"
                                            Style="{StaticResource InlineLinkStyle}" Content="打开完整日志文件" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!--  ══════════════════════════ 关于  ══════════════════════════  -->
                <ScrollViewer
                    x:Name="AboutPage"
                    Padding="16,12,16,16"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <Grid x:Name="AboutHost"
                        Width="{Binding ViewportWidth, ElementName=AboutPage}"
                        MaxWidth="640"
                        HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Stretch">

                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于" />

                            <Border x:Name="AboutCard" Style="{StaticResource GroupCardStyle}">
                                <StackPanel Spacing="4">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                x:Name="AboutLogo"
                                                Width="64"
                                                Height="64"
                                                VerticalAlignment="Center"
                                                Source="ms-appx:///Assets/app_64.png" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="SNNU 校园网助手" />
                                                <TextBlock
                                                    x:Name="AboutVersionText"
                                                    Style="{StaticResource RowDescStyle}"
                                                    Text="版本 —" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="认证门户" />
                                            <HyperlinkButton
                                                x:Name="PortalLink"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource InlineLinkStyle}"
                                                Content="202.117.144.205"
                                                NavigateUri="http://202.117.144.205/"
                                                AutomationProperties.Name="打开校园网认证门户 202.117.144.205" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="源代码" />
                                            <StackPanel
                                                x:Name="AboutLinks"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <HyperlinkButton
                                                    Style="{StaticResource InlineLinkStyle}"
                                                    Content="GitHub"
                                                    NavigateUri="https://github.com/mzh2077/SNNUAutoLogin-GUI" />
                                                <HyperlinkButton
                                                    Style="{StaticResource InlineLinkStyle}"
                                                    Content="Gitee"
                                                    NavigateUri="https://gitee.com/mzh2077/SNNUAutoLogin-GUI" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowTitleStyle}"
                                                Text="问题反馈" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <HyperlinkButton
                                                    Style="{StaticResource InlineLinkStyle}"
                                                    Content="GitHub Issues"
                                                    NavigateUri="https://github.com/mzh2077/SNNUAutoLogin-GUI/issues" />
                                                <HyperlinkButton
                                                    Style="{StaticResource InlineLinkStyle}"
                                                    Content="Gitee Issues"
                                                    NavigateUri="https://gitee.com/mzh2077/SNNUAutoLogin-GUI/issues" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource RowTitleStyle}"
                                                    Text="开源许可" />
                                                <!-- 图标里的学士帽字形来自 Fluent System Icons，MIT 许可，见仓库根目录 NOTICE.md -->
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="图标来自 Microsoft Fluent System Icons"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource HintStyle}"
                                                Text="PolyForm Noncommercial 1.0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
